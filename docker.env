#DB_URL=postgres://postgres:postgres@localhost:15432/postgres
#REDIS_URL=localhost:16379

SOURCE_CONFIG=./source.config.json
PRESETS=./presets.json

USE_CACHE=true
USE_VISION_CACHE=true
CACHE_DIR=./cache/sources

USE_RENDER_CACHE=false
RENDER_CACHE_DIR=./cache/renders

USE_SOURCE_CONFIG_CACHE=true

REQUIRE_SIG_VALIDATION=true
REQUIRE_PRESET_SIG_VALIDATION=false

ALLOW_PRESET_MANAGEMENT=true
API_KEY=secret

GOOGLE_APPLICATION_CREDENTIALS=./google.json

ALWAYS_PRERENDER=true

USE_ML=true
ONNX_LIB=./libs/onnx/linux/lib/libonnxruntime.so
ONNX_MODEL_HUMANS=./models/u2net_human_seg.onnx
ONNX_MODEL_FOREGROUND=./models/u2net.onnx
ONNX_MODEL_FACE_DETECTOR=./models/yolov5s-face.onnx
ONNX_USE_CORE_ML=false

USE_RATE_LIMITER=false
TOKENS_PER_MINUTE=120